diff --git a/ppu/include/rsx/rsx_function_macros.h b/ppu/include/rsx/rsx_function_macros.h
index bffc3a1..cb2a9fe 100644
--- a/ppu/include/rsx/rsx_function_macros.h
+++ b/ppu/include/rsx/rsx_function_macros.h
@@ -12,23 +12,32 @@
 	#define RSX_FUNC_INTERNAL(func)		__rsx##func##Unsafe
 	#define RSX_CONTEXT_CURRENT_BEGIN(count) do {} while(0)	
 #else
+	/* Calls the firmware's command-buffer callback (a 32-bit function descriptor)
+	   when the buffer is full. The arguments are bound to r3/r4 explicitly, and the
+	   asm declares everything the callee may change: all volatile registers and
+	   memory (it moves context->current). Without that, GCC 11+ (ipa-modref,
+	   ipa-ra) keeps the stale write pointer in a register across the call and the
+	   next commands land past the end of the buffer, hanging the RSX at the first
+	   wrap. */
 	s32 __attribute__((noinline)) rsxContextCallback(gcmContextData *context,u32 count)
 	{
-		register s32 result asm("r3");
+		register u64 a1 asm("r3") = (u64)(uintptr_t)context;
+		register u64 a2 asm("r4") = count;
 		__asm__ __volatile__ (
             "stdu	1,-128(1)\n"
             "mr		31,2\n"
-            "lwz	0,0(%3)\n"
-            "lwz	2,4(%3)\n"
+            "lwz	0,0(%2)\n"
+            "lwz	2,4(%2)\n"
             "mtctr	0\n"
             "bctrl\n"
             "mr		2,31\n"
             "addi	1,1,128\n"
-            : "+r"(result)
-            : "r"(context), "r"(count), "b"(context->callback)
-            : "r31", "r0", "lr"
+            : "+r"(a1), "+r"(a2)
+            : "b"(context->callback)
+            : "r31", "r0", "lr", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12",
+              "ctr", "xer", "cr0", "cr1", "cr5", "cr6", "cr7", "memory"
 		);
-		return result;
+		return (s32)a1;
 	}
 	
 	#define RSX_FUNC_INTERNAL(func)		__rsx##func
