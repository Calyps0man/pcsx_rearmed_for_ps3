From: Claude <noreply@anthropic.com>
Date: Fri, 30 Oct 2026 22:33:40 +0000
Subject: [PATCH] PS3: counters for the front end's slow-frame log (CD read
 time, Lightrec blocks)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HyAyv1PvGqyTegufofF5fp
---
 deps/lightrec/lightrec.c  |  8 ++++++++
 libpcsxcore/cdrom-async.c | 22 ++++++++++++++++++++++
 2 files changed, 30 insertions(+)

diff --git a/deps/lightrec/lightrec.c b/deps/lightrec/lightrec.c
index 7211a301..c001a55c 100644
--- a/deps/lightrec/lightrec.c
+++ b/deps/lightrec/lightrec.c
@@ -119,6 +119,14 @@ static const struct lightrec_mem_map_ops lightrec_default_ops = {
 
 struct lightrec_dbg lightrec_dbg;
 
+/* blocks run by the interpreter, blocks compiled (by any thread), blocks found */
+void lightrec_debug_counts(u32 *c)
+{
+	c[0] = lightrec_dbg.n_interp;
+	c[1] = lightrec_dbg.n_comp;
+	c[2] = lightrec_dbg.n_precomp;
+}
+
 unsigned int lightrec_bad_accesses;
 u32 lightrec_bad_access_addr, lightrec_bad_access_pc;
 
diff --git a/libpcsxcore/cdrom-async.c b/libpcsxcore/cdrom-async.c
index 264c739c..7eb2494e 100644
--- a/libpcsxcore/cdrom-async.c
+++ b/libpcsxcore/cdrom-async.c
@@ -11,6 +11,7 @@
  ***************************************************************************/
 
 #include <stdalign.h>
+#include <stdint.h>
 #include <stdlib.h>
 #include <string.h>
 #include "system.h"
@@ -320,8 +321,29 @@ int cdra_prefetch(unsigned char m, unsigned char s, unsigned char f, int is_cdda
    return ret;
 }
 
+/* time spent reading sectors on the emulation thread (timebase ticks, PowerPC) and
+   the number of reads, for front ends that report slow frames */
+uint64_t cdra_prof_ticks;
+unsigned int cdra_prof_reads;
+
+static int cdra_do_read_(const unsigned char *time, int is_cdda,
+      void *buf, void *buf_sub);
 static int cdra_do_read(const unsigned char *time, int is_cdda,
       void *buf, void *buf_sub)
+{
+#if defined(__powerpc__) || defined(__ppc__) || defined(__PPC__)
+   uint64_t t0 = __builtin_ppc_get_timebase();
+   int ret = cdra_do_read_(time, is_cdda, buf, buf_sub);
+   cdra_prof_ticks += __builtin_ppc_get_timebase() - t0;
+#else
+   int ret = cdra_do_read_(time, is_cdda, buf, buf_sub);
+#endif
+   cdra_prof_reads++;
+   return ret;
+}
+
+static int cdra_do_read_(const unsigned char *time, int is_cdda,
+      void *buf, void *buf_sub)
 {
    u32 lba = MSF2SECT(time[0], time[1], time[2]);
    int hit = 0, ret = -1, read_locked = 0;
-- 
