 static atomic_uint lightrec_bytes[MEM_TYPE_END];
diff --git a/deps/lightrec/recompiler.c b/deps/lightrec/recompiler.c
index 56911703..85310361 100644
--- a/deps/lightrec/recompiler.c
+++ b/deps/lightrec/recompiler.c
@@ -116,11 +116,19 @@ static void lightrec_cancel_list(struct recompiler *rec)
 	}
 }
 
+extern unsigned int lightrec_code_flushes;
+
 static void lightrec_flush_code_buffer(struct lightrec_state *state, void *d)
 {
 	struct recompiler *rec = d;
 
-	lightrec_remove_outdated_blocks(state->block_cache, NULL);
+	/* Runs from the reaper, outside block code, with the compiler idle: free
+	 * every block, as the single-threaded compiler does when the buffer is full
+	 * (lightrec_remove_outdated_blocks() alone rarely frees anything: its age
+	 * test compares against a cycle counter reset at every exit, so the buffer
+	 * stayed full and new blocks were only ever interpreted). */
+	lightrec_free_all_blocks_except(state->block_cache, NULL);
+	lightrec_code_flushes++;
 	rec->must_flush = false;
 }
 
diff --git a/include/lightrec/lightrec-config.h b/include/lightrec/lightrec-config.h
index 19b852ce..23e5cf63 100644
--- a/include/lightrec/lightrec-config.h
+++ b/include/lightrec/lightrec-config.h
@@ -6,7 +6,16 @@
 #ifndef __LIGHTREC_CONFIG_H__
 #define __LIGHTREC_CONFIG_H__
 
+#if LIGHTREC_THREADED_RUNTIME && LIGHTREC_ENABLE_THREADED_COMPILER
+/* PS3: built with the threaded compiler, switched on or off at run time (a front-end
+   setting; lightrec_plugin_set_threaded() restarts Lightrec when it changes) */
+extern int lightrec_threaded_compiler;
+#define ENABLE_THREADED_COMPILER lightrec_threaded_compiler
+#define LIGHTREC_THREADED_BUILT 1
+#else
 #define ENABLE_THREADED_COMPILER LIGHTREC_ENABLE_THREADED_COMPILER
+#define LIGHTREC_THREADED_BUILT LIGHTREC_ENABLE_THREADED_COMPILER
+#endif
 #define ENABLE_FIRST_PASS 1
 #define ENABLE_DISASSEMBLER LIGHTREC_ENABLE_DISASSEMBLER
 #define ENABLE_CODE_BUFFER 1
diff --git a/libpcsxcore/lightrec/plugin.c b/libpcsxcore/lightrec/plugin.c
index 53a33505..052797b1 100644
--- a/libpcsxcore/lightrec/plugin.c
+++ b/libpcsxcore/lightrec/plugin.c
@@ -713,6 +713,7 @@ static void lightrec_plugin_apply_config()
 static void lightrec_plugin_shutdown(void)
 {
 	lightrec_destroy(lightrec_state);
+	lightrec_state = NULL;
 
 	if (!LIGHTREC_CUSTOM_MAP) {
 #if defined(__lv2ppu__)
@@ -725,6 +726,29 @@ static void lightrec_plugin_shutdown(void)
 	}
 }
 
+#if LIGHTREC_THREADED_RUNTIME && LIGHTREC_ENABLE_THREADED_COMPILER
+int lightrec_threaded_compiler = 1;
+
+/* The front end's setting, before a game is loaded: Lightrec compiles new blocks on
+ * a second thread (they run in Lightrec's interpreter until compiled, so a burst of
+ * new code no longer holds up the frame), or on the emulation thread. Lightrec is
+ * restarted when it changes; the game's reset rebuilds its blocks anyway. */
+void lightrec_plugin_set_threaded(int on)
+{
+	on = !!on;
+	if (on == lightrec_threaded_compiler)
+		return;
+	if (lightrec_state && psxCpu == &psxRec) {
+		lightrec_plugin_shutdown();
+		lightrec_threaded_compiler = on;
+		lightrec_plugin_init();
+	} else {
+		lightrec_threaded_compiler = on;
+	}
+	SysPrintf("lightrec: blocks compiled %s\n", on ? "on a second thread" : "on the emulation thread");
+}
+#endif
+
 static void lightrec_plugin_reset(void)
 {
 	struct lightrec_registers *regs;
diff --git a/libpcsxcore/lightrec/ps3/pthread.c b/libpcsxcore/lightrec/ps3/pthread.c
new file mode 100644
index 00000000..0a46241f
--- /dev/null
+++ b/libpcsxcore/lightrec/ps3/pthread.c
@@ -0,0 +1,121 @@
+/* lv2 versions of the POSIX thread calls Lightrec's threaded compiler uses (see
+ * pthread.h). Error returns are lv2 codes (non-zero), which is all Lightrec tests. */
+#include <stdlib.h>
+#include <string.h>
+#include <sys/thread.h>
+#include <sys/mutex.h>
+#include <sys/cond.h>
+#include "pthread.h"
+
+/* the compiler worker: just below the emulator thread (priority 1000), so it uses
+   the PPU's second hardware thread without ever pushing the emulation aside */
+#define WORKER_PRIORITY 1001
+#define WORKER_STACK (512 * 1024)
+
+struct start_box { void *(*start)(void *); void *arg; };
+
+static void trampoline(void *p)
+{
+	struct start_box b = *(struct start_box *)p;
+	free(p);
+	b.start(b.arg);
+	sysThreadExit(0);
+}
+
+int pthread_create(pthread_t *t, const pthread_attr_t *attr, void *(*start)(void *), void *arg)
+{
+	struct start_box *b = malloc(sizeof *b);
+	sys_ppu_thread_t id;
+	s32 r;
+	(void)attr;
+	if (!b)
+		return -1;
+	b->start = start; b->arg = arg;
+	r = sysThreadCreate(&id, trampoline, b, WORKER_PRIORITY, WORKER_STACK, THREAD_JOINABLE, (char *)"lightrec compiler");
+	if (r) {
+		free(b);
+		return r;
+	}
+	t->id = id;
+	return 0;
+}
+
+int pthread_join(pthread_t t, void **ret)
+{
+	u64 v;
+	s32 r = sysThreadJoin(t.id, &v);
+	if (ret)
+		*ret = NULL;
+	return r;
+}
+
+static sys_mutex_t new_mutex(void)
+{
+	sys_mutex_attr_t a;
+	sys_mutex_t m = 0;
+	memset(&a, 0, sizeof a);
+	a.attr_protocol = SYS_MUTEX_PROTOCOL_PRIO;
+	a.attr_recursive = SYS_MUTEX_ATTR_NOT_RECURSIVE;
+	a.attr_pshared = SYS_MUTEX_ATTR_NOT_PSHARED;
+	a.attr_adaptive = SYS_MUTEX_ATTR_NOT_ADAPTIVE;
+	memcpy(a.name, "lightrc", 8);
+	return sysMutexCreate(&m, &a) ? 0 : m;
+}
+
+int pthread_mutex_init(pthread_mutex_t *m, const pthread_mutexattr_t *attr)
+{
+	(void)attr;
+	m->id = new_mutex();
+	return m->id ? 0 : -1;
+}
+int pthread_mutex_destroy(pthread_mutex_t *m) { return sysMutexDestroy(m->id); }
+int pthread_mutex_lock(pthread_mutex_t *m) { return sysMutexLock(m->id, 0); }
+int pthread_mutex_unlock(pthread_mutex_t *m) { return sysMutexUnlock(m->id); }
+
+/* guards making condition variables (two threads may wait on a new one at once) */
+static sys_mutex_t make_lock;
+
+int pthread_cond_init(pthread_cond_t *c, const pthread_condattr_t *attr)
+{
+	(void)attr;
+	c->id = c->mutex = 0;
+	c->made = 0;
+	if (!make_lock)                  /* first use: Lightrec initialises on one thread */
+		make_lock = new_mutex();
+	return make_lock ? 0 : -1;
+}
+
+int pthread_cond_destroy(pthread_cond_t *c)
+{
+	if (c->made)
+		sysCondDestroy(c->id);
+	c->made = 0;
+	return 0;
+}
+
+int pthread_cond_wait(pthread_cond_t *c, pthread_mutex_t *m)
+{
+	if (!c->made) {
+		sysMutexLock(make_lock, 0);
+		if (!c->made) {
+			sys_cond_attr_t a;
+			memset(&a, 0, sizeof a);
+			a.attr_pshared = SYS_COND_ATTR_PSHARED;   /* 0x200, as sysCondAttrInitialize sets it (lv2: not process-shared) */
+			memcpy(a.name, "lightrc", 8);
+			if (sysCondCreate(&c->id, m->id, &a)) {
+				sysMutexUnlock(make_lock);
+				return -1;
+			}
+			c->mutex = m->id;
+			__asm__ volatile("lwsync" : : : "memory");
+			c->made = 1;
+		}
+		sysMutexUnlock(make_lock);
+	}
+	return sysCondWait(c->id, 0);
+}
+
+/* nobody can be waiting on one not made yet: a waiter makes it while holding the
+   mutex, and Lightrec signals with that mutex held */
+int pthread_cond_signal(pthread_cond_t *c) { return c->made ? sysCondSignal(c->id) : 0; }
+int pthread_cond_broadcast(pthread_cond_t *c) { return c->made ? sysCondBroadcast(c->id) : 0; }
diff --git a/libpcsxcore/lightrec/ps3/pthread.h b/libpcsxcore/lightrec/ps3/pthread.h
new file mode 100644
index 00000000..2a15c5e2
--- /dev/null
+++ b/libpcsxcore/lightrec/ps3/pthread.h
@@ -0,0 +1,27 @@
+/* The POSIX thread calls Lightrec's threaded compiler uses (recompiler.c, reaper.c),
+ * for the PS3: PSL1GHT's C library declares no threads. Found before the system's
+ * pthread.h only by Lightrec's files (Makefile.libretro, psl1ght). Built on lv2's
+ * PPU threads, mutexes and condition variables (pthread.c). */
+#ifndef PS3_LIGHTREC_PTHREAD_H
+#define PS3_LIGHTREC_PTHREAD_H
+#include <stdint.h>
+
+typedef struct { uint64_t id; } pthread_t;            /* lv2 PPU thread id */
+typedef struct { uint32_t id; } pthread_mutex_t;      /* lv2 mutex */
+/* lv2 ties a condition variable to its mutex when it is created: made at the
+   first wait, with the mutex that wait is given */
+typedef struct { uint32_t id, mutex; volatile int made; } pthread_cond_t;
+typedef int pthread_attr_t, pthread_mutexattr_t, pthread_condattr_t;
+
+int pthread_create(pthread_t *t, const pthread_attr_t *attr, void *(*start)(void *), void *arg);
+int pthread_join(pthread_t t, void **ret);
+int pthread_mutex_init(pthread_mutex_t *m, const pthread_mutexattr_t *attr);
+int pthread_mutex_destroy(pthread_mutex_t *m);
+int pthread_mutex_lock(pthread_mutex_t *m);
+int pthread_mutex_unlock(pthread_mutex_t *m);
+int pthread_cond_init(pthread_cond_t *c, const pthread_condattr_t *attr);
+int pthread_cond_destroy(pthread_cond_t *c);
+int pthread_cond_wait(pthread_cond_t *c, pthread_mutex_t *m);
+int pthread_cond_signal(pthread_cond_t *c);
+int pthread_cond_broadcast(pthread_cond_t *c);
+#endif
