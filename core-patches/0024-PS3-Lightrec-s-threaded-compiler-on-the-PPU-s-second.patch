From 1178152c28317971a4bc845c3c52c2541bfeba80 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 30 Oct 2026 21:29:50 +0000
Subject: [PATCH] PS3: Lightrec's threaded compiler on the PPU's second thread,
 switched at run time

Lightrec compiled every new block on the emulation thread: a game loading a lot
of new code at once (GT2's race start: about 2000 blocks) held frames up to
275 ms. Its threaded compiler runs blocks in the interpreter until a worker has
compiled them.

- psl1ght builds it (LIGHTREC_THREADED_COMPILER), with LIGHTREC_THREADED_RUNTIME:
  ENABLE_THREADED_COMPILER is then a variable, and the structures and atomics it
  needs are always built (LIGHTREC_THREADED_BUILT replaces the #if tests).
  lightrec_plugin_set_threaded() restarts Lightrec when the front end's setting
  changes (before a game is loaded).
- libpcsxcore/lightrec/ps3: the POSIX thread calls Lightrec uses, on lv2 PPU
  threads, mutexes and condition variables (made at the first wait, as lv2 ties
  a condition variable to its mutex). One worker, just below the emulator's
  priority.
- The threaded compiler's code-buffer flush (from the reaper, outside block
  code) frees every block, as the single-threaded path does since 0018:
  removing only outdated blocks rarely freed anything, and new blocks would
  then only ever be interpreted.

Host check (ppc64 big-endian under QEMU, Linux threads): the 72 test programs
give the same frames threaded, switched off at run time, and with the previous
build.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HyAyv1PvGqyTegufofF5fp
---
 Makefile.libretro                  |   6 ++
 deps/lightrec/lightrec-private.h   |  10 +--
 deps/lightrec/lightrec.c           |   2 +-
 deps/lightrec/memmanager.c         |   2 +-
 deps/lightrec/recompiler.c         |  10 ++-
 include/lightrec/lightrec-config.h |   9 +++
 libpcsxcore/lightrec/plugin.c      |  24 ++++++
 libpcsxcore/lightrec/ps3/pthread.c | 121 +++++++++++++++++++++++++++++
 libpcsxcore/lightrec/ps3/pthread.h |  27 +++++++
 9 files changed, 203 insertions(+), 8 deletions(-)
 create mode 100644 libpcsxcore/lightrec/ps3/pthread.c
 create mode 100644 libpcsxcore/lightrec/ps3/pthread.h

diff --git a/Makefile.libretro b/Makefile.libretro
index 85d82942..df6af909 100644
--- a/Makefile.libretro
+++ b/Makefile.libretro
@@ -320,6 +320,12 @@ else ifeq ($(platform), psl1ght)
 	USE_ASYNC_CDROM = 1
   libpcsxcore/cdrom-async.o frontend/libretro.o: CFLAGS += -DHAVE_CDROM
 	USE_ASYNC_GPU = 1
+	# Lightrec's threaded compiler, switched on or off at run time by the front end;
+	# its few POSIX thread calls come from libpcsxcore/lightrec/ps3 (lv2 threads)
+	LIGHTREC_THREADED_COMPILER := 1
+	CFLAGS += -DLIGHTREC_THREADED_RUNTIME=1
+  deps/lightrec/%.o: CFLAGS += -Ilibpcsxcore/lightrec/ps3
+	OBJS += libpcsxcore/lightrec/ps3/pthread.o
 	# pcsxr-threads.c has its own lv2 thread code
 	NO_FEATURES_CPU = 1
 	USE_ASYNC_SPU = 0
diff --git a/deps/lightrec/lightrec-private.h b/deps/lightrec/lightrec-private.h
index 0c3eb3e2..78a9df6a 100644
--- a/deps/lightrec/lightrec-private.h
+++ b/deps/lightrec/lightrec-private.h
@@ -12,7 +12,7 @@
 #include "lightrec.h"
 #include "regcache.h"
 
-#if ENABLE_THREADED_COMPILER
+#if LIGHTREC_THREADED_BUILT
 #include <stdatomic.h>
 #endif
 
@@ -124,7 +124,7 @@ struct block {
 	u32 precompile_date;
 	unsigned int code_size;
 	u16 nb_ops;
-#if ENABLE_THREADED_COMPILER
+#if LIGHTREC_THREADED_BUILT
 	_Atomic u8 flags;
 #else
 	u8 flags;
@@ -351,7 +351,7 @@ static inline s16 s16_max(s16 a, s16 b)
 
 static inline _Bool block_has_flag(struct block *block, u8 flag)
 {
-#if ENABLE_THREADED_COMPILER
+#if LIGHTREC_THREADED_BUILT
 	return atomic_load_explicit(&block->flags, memory_order_relaxed) & flag;
 #else
 	return block->flags & flag;
@@ -360,7 +360,7 @@ static inline _Bool block_has_flag(struct block *block, u8 flag)
 
 static inline u8 block_set_flags(struct block *block, u8 mask)
 {
-#if ENABLE_THREADED_COMPILER
+#if LIGHTREC_THREADED_BUILT
 	return atomic_fetch_or_explicit(&block->flags, mask,
 					memory_order_relaxed);
 #else
@@ -374,7 +374,7 @@ static inline u8 block_set_flags(struct block *block, u8 mask)
 
 static inline u8 block_clear_flags(struct block *block, u8 mask)
 {
-#if ENABLE_THREADED_COMPILER
+#if LIGHTREC_THREADED_BUILT
 	return atomic_fetch_and_explicit(&block->flags, ~mask,
 					 memory_order_relaxed);
 #else
