From bff949b3e699cc51c890111f4bcfac5f76b8ea6e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 20:33:39 +0000
Subject: [PATCH] mdec: hooks for decoding ahead on other processors

mdec_stream_hook is told when a decode command's run-length stream starts
(and when any earlier stream becomes void: reset, savestate load);
mdec_decode_hook can supply whole macroblocks for a DMA1 transfer, the
core decodes whatever it leaves. Used by the PS3 front end to decode
FMV frames on the SPUs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HyAyv1PvGqyTegufofF5fp
---
 libpcsxcore/mdec.c | 32 ++++++++++++++++++++++++++++++++
 libpcsxcore/mdec.h | 12 ++++++++++++
 2 files changed, 44 insertions(+)

diff --git a/libpcsxcore/mdec.c b/libpcsxcore/mdec.c
index 1342c841..eda48334 100644
--- a/libpcsxcore/mdec.c
+++ b/libpcsxcore/mdec.c
@@ -88,6 +88,17 @@ static int iq_y[DSIZE2], iq_uv[DSIZE2];
 
 #define STP_A ((mdec.reg0 & MDEC0_STP) ? 0x8000 : 0)
 
+int (*mdec_decode_hook)(const unsigned short **rl, unsigned char *image, int n,
+		int rgb24, int stp, int bw, const int *iq_y, const int *iq_uv);
+void (*mdec_stream_hook)(const unsigned short *rl, const unsigned short *rl_end,
+		int rgb24, int stp, int bw, const int *iq_y, const int *iq_uv);
+
+static void stream_forget(void)
+{
+	if (mdec_stream_hook)
+		mdec_stream_hook(NULL, NULL, 0, 0, 0, NULL, NULL);
+}
+
 
 static int aanscales[DSIZE2] = {
 	1048576, 1454417, 1370031, 1232995, 1048576,  823861, 567485, 289301,
@@ -114,6 +125,7 @@ void mdecInit(void) {
 	memset(iq_y, 0, sizeof(iq_y));
 	memset(iq_uv, 0, sizeof(iq_uv));
 	mdec.rl = (u16 *)&psxRegs.ptrs.psxM[0x100000];
+	stream_forget();
 }
 
 // command register
@@ -132,6 +144,7 @@ void mdecWrite1(u32 data) {
 		mdec.reg1 = 0;
 		mdec.pending_dma1.adr = 0;
 		mdec.block_buffer_pos = 0;
+		stream_forget();
 	}
 }
 
@@ -175,6 +188,10 @@ void psxDma0(u32 adr, u32 bcr, u32 chcr) {
 			if(mdec.rl_end <= mdec.rl)
 				break;
 
+			if (mdec_stream_hook)
+				mdec_stream_hook(mdec.rl, mdec.rl_end, !(cmd & MDEC0_RGB24),
+					(cmd & MDEC0_STP) ? 0x8000 : 0, Config.Mdec, iq_y, iq_uv);
+
 			/* process the pending dma1 */
 			if(mdec.pending_dma1.adr){
 				psxDma1(mdec.pending_dma1.adr, mdec.pending_dma1.bcr, mdec.pending_dma1.chcr);
@@ -265,6 +282,13 @@ void psxDma1(u32 adr, u32 bcr, u32 chcr) {
 			mdec.block_buffer_pos = 0;
 		}
 
+		if (mdec_decode_hook && size >= SIZE_OF_16B_BLOCK) {
+			int n = mdec_decode_hook(&mdec.rl, image, size / SIZE_OF_16B_BLOCK,
+						 0, STP_A, Config.Mdec, iq_y, iq_uv);
+			image += n * SIZE_OF_16B_BLOCK;
+			size -= n * SIZE_OF_16B_BLOCK;
+		}
+
 		while(size >= SIZE_OF_16B_BLOCK) {
 			mdec.rl = rl2blk(blk, mdec.rl, iq_y, iq_uv);
 			yuv2rgb15(blk, (u16 *)image, STP_A, Config.Mdec);
@@ -294,6 +318,13 @@ void psxDma1(u32 adr, u32 bcr, u32 chcr) {
 			mdec.block_buffer_pos = 0;
 		}
 
+		if (mdec_decode_hook && size >= SIZE_OF_24B_BLOCK) {
+			int n = mdec_decode_hook(&mdec.rl, image, size / SIZE_OF_24B_BLOCK,
+						 1, 0, Config.Mdec, iq_y, iq_uv);
+			image += n * SIZE_OF_24B_BLOCK;
+			size -= n * SIZE_OF_24B_BLOCK;
+		}
+
 		while(size >= SIZE_OF_24B_BLOCK) {
 			mdec.rl = rl2blk(blk, mdec.rl, iq_y, iq_uv);
 			yuv2rgb24(blk, image, Config.Mdec);
@@ -386,6 +417,7 @@ int mdecFreeze(void *f, int Mode) {
 	gzfreeze(&mdec.pending_dma1, sizeof(mdec.pending_dma1));
 	gzfreeze(iq_y, sizeof(iq_y));
 	gzfreeze(iq_uv, sizeof(iq_uv));
+	stream_forget();
 
 	return 0;
 }
diff --git a/libpcsxcore/mdec.h b/libpcsxcore/mdec.h
index ba38b4b6..a99aa881 100644
--- a/libpcsxcore/mdec.h
+++ b/libpcsxcore/mdec.h
@@ -40,6 +40,18 @@ void mdec0Interrupt();
 void mdec1Interrupt();
 int mdecFreeze(void *f, int Mode);
 
+/* Optional: a front end can decode whole macroblocks elsewhere (the PS3 SPUs)
+ * with the routines in mdec_decode.h. Decodes up to n macroblocks from *rl into
+ * image (16 bpp: 512 bytes each, 24 bpp: 768), advances *rl and returns how
+ * many it decoded; 0 leaves them to the core. stp: 0x8000 or 0, bw: monochrome. */
+extern int (*mdec_decode_hook)(const unsigned short **rl, unsigned char *image, int n,
+		int rgb24, int stp, int bw, const int *iq_y, const int *iq_uv);
+/* Optional: told when decoding of a run-length stream starts (rl..rl_end, the
+ * game leaves that RAM alone until the MDEC has consumed it), so the front end
+ * can decode ahead; rl NULL: forget any stream (reset, savestate load). */
+extern void (*mdec_stream_hook)(const unsigned short *rl, const unsigned short *rl_end,
+		int rgb24, int stp, int bw, const int *iq_y, const int *iq_uv);
+
 #ifdef __cplusplus
 }
 #endif
