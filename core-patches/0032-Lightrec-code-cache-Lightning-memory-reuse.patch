     __atomic_fetch_add(&jit_mem_bytes, size, __ATOMIC_RELAXED);
@@ -108,7 +114,7 @@ jit_realloc(jit_pointer_t *ptr, jit_word_t old_size, jit_word_t new_size)
     JIT_MEM_T0();
     *ptr = (*jit_realloc_ptr)(*ptr, new_size);
     if (old_size < new_size)
-	memset((jit_int8_t*)*ptr + old_size, 0, new_size - old_size);
+	jit_zero((jit_int8_t*)*ptr + old_size, new_size - old_size);
     JIT_MEM_T1();
     __atomic_fetch_add(&jit_mem_calls, 1, __ATOMIC_RELAXED);
 }
@@ -125,6 +131,150 @@ jit_free(jit_pointer_t *ptr)
     }
 }
 
+#if defined(JIT_MEM_CACHE)
+/*
+ * Each compile makes a jit state and throws it away, allocating and clearing
+ * the same buffers every time (about 75 KB, 30 calls per block on the PS3).
+ * Freed buffers of 1 KB and more are kept by size and handed out again (a
+ * small header holds the size), and buffers are cleared a cache line at a
+ * time with dcbz on PowerPC: the C library's memset reads every line from
+ * memory before overwriting it. All of Lightning's memory goes through here.
+ */
+#  define JMC_HDR	16
+#  define JMC_MIN	1024
+#  define JMC_SIZES	32
+#  define JMC_PER	8
+static struct { size_t size; unsigned int n; void *p[JMC_PER]; } jmc[JMC_SIZES];
+static int jmc_lock;
+
+static inline void jmc_acquire(void)
+{
+    while (__atomic_test_and_set(&jmc_lock, __ATOMIC_ACQUIRE))
+	;
+}
+
+static inline void jmc_release(void)
+{
+    __atomic_clear(&jmc_lock, __ATOMIC_RELEASE);
+}
+
+static void *
+jit_default_alloc_func(size_t size)
+{
+    char *p = NULL;
+    unsigned int i;
+
+    if (size >= JMC_MIN) {
+	jmc_acquire();
+	for (i = 0; i < JMC_SIZES; i++) {
+	    if (jmc[i].size == size && jmc[i].n) {
+		p = jmc[i].p[--jmc[i].n];
+		break;
+	    }
+	}
+	jmc_release();
+	if (p)
+	    return p + JMC_HDR;
+    }
+
+    p = malloc(size + JMC_HDR);
+    if (!p)
+	return NULL;
+    *(size_t *)p = size;
+    return p + JMC_HDR;
+}
+
+static void *
+jit_default_realloc_func(void *ptr, size_t size)
+{
+    char *p;
+
+    if (!ptr)
+	return jit_default_alloc_func(size);
+    p = realloc((char *)ptr - JMC_HDR, size + JMC_HDR);
+    if (!p)
+	return NULL;
+    *(size_t *)p = size;
+    return p + JMC_HDR;
+}
+
+static void
+jit_default_free_func(void *ptr)
+{
+    char *p = (char *)ptr - JMC_HDR;
+    size_t size = *(size_t *)p;
+    unsigned int i, empty = JMC_SIZES;
+
+    if (size >= JMC_MIN) {
+	jmc_acquire();
+	for (i = 0; i < JMC_SIZES; i++) {
+	    if (jmc[i].size == size) {
+		if (jmc[i].n < JMC_PER) {
+		    jmc[i].p[jmc[i].n++] = p;
+		    p = NULL;
+		}
+		break;
+	    }
+	    if (!jmc[i].n && empty == JMC_SIZES)
+		empty = i;
+	}
+	if (p && i == JMC_SIZES && empty < JMC_SIZES) {
+	    jmc[empty].size = size;
+	    jmc[empty].p[0] = p;
+	    jmc[empty].n = 1;
+	    p = NULL;
+	}
+	jmc_release();
+    }
+    if (p)
+	free(p);
+}
+
+/* bytes dcbz clears (cache line), found once; 0: use memset */
+static int jit_dcbz_size = -1;
+
+static int
+jit_dcbz_probe(void)
+{
+#  if defined(__powerpc__) || defined(__ppc__) || defined(__PPC__)
+    static unsigned char buf[1024] __attribute__((aligned(256)));
+    unsigned char *line = buf + 256;
+    int n = 0;
+
+    memset(buf, 0xff, sizeof(buf));
+    __asm__ volatile("dcbz 0,%0" : : "r"(line) : "memory");
+    while (n < 512 && line[n] == 0)
+	n++;
+    /* only a clean power-of-two line, nothing touched before it */
+    if ((n == 32 || n == 64 || n == 128) && buf[255] == 0xff && line[n] == 0xff)
+	return n;
+#  endif
+    return 0;
+}
+
+static void
+jit_zero(void *ptr, size_t size)
+{
+    int line = jit_dcbz_size;
+
+    if (line < 0)
+	line = jit_dcbz_size = jit_dcbz_probe();
+#  if defined(__powerpc__) || defined(__ppc__) || defined(__PPC__)
+    if (line && size >= 4 * (size_t)line) {
+	uintptr_t a = (uintptr_t)ptr, end = a + size;
+	uintptr_t first = (a + line - 1) & ~(uintptr_t)(line - 1);
+	uintptr_t last = end & ~(uintptr_t)(line - 1);
+
+	memset(ptr, 0, first - a);
+	for (; first < last; first += line)
+	    __asm__ volatile("dcbz 0,%0" : : "r"(first) : "memory");
+	memset((void *)last, 0, end - last);
+	return;
+    }
+#  endif
+    memset(ptr, 0, size);
+}
+#else
 static void *
 jit_default_alloc_func(size_t size)
 {
@@ -142,3 +292,4 @@ jit_default_free_func(void *ptr)
 {
     free(ptr);
 }
+#endif
diff --git a/deps/lightrec/blockcache.c b/deps/lightrec/blockcache.c
index f1fb149a..46537f20 100644
--- a/deps/lightrec/blockcache.c
+++ b/deps/lightrec/blockcache.c
@@ -17,11 +17,141 @@
 /* Must be power of two */
 #define LUT_SIZE 0x4000
 
+/* code cache: blocks retired because their code was overwritten, kept with
+ * their compiled code, oldest first. A game that loads the same code again
+ * (a racing game's race code after the menus) gets the blocks back without
+ * compiling them: a compile costs about 0.3 to 2 ms per block on the PS3. */
+#define STASH_BUCKETS	1024			/* power of two */
+#define STASH_MAX	4096			/* blocks */
+#define STASH_BYTES	(2 * 1024 * 1024)	/* compiled code kept */
+
 struct blockcache {
 	struct lightrec_state *state;
 	struct block * lut[LUT_SIZE];
+	struct block * stash[STASH_BUCKETS];	/* chained through block->next */
+	struct block * stash_ring[STASH_MAX];	/* insertion order, NULL = taken */
+	u32 stash_head, stash_used, stash_count;
+	size_t stash_bytes;
 };
 
+static inline u32 stash_bucket(u32 pc)
+{
+	return (kunseg(pc) >> 2) & (STASH_BUCKETS - 1);
+}
+
+static void stash_unlink(struct blockcache *cache, struct block *block)
+{
+	struct block **p = &cache->stash[stash_bucket(block->pc)];
+
+	for (; *p; p = &(*p)->next) {
+		if (*p == block) {
+			*p = block->next;
+			break;
+		}
+	}
+
+	block->next = NULL;
+	cache->stash_ring[block->stash_slot] = NULL;
+	cache->stash_count--;
+	cache->stash_bytes -= block->code_size;
+}
+
+/* drops the oldest kept block (a slot left empty by a taken one is skipped) */
+static bool stash_drop_oldest(struct blockcache *cache)
+{
+	struct block *block;
+
+	while (cache->stash_used) {
+		block = cache->stash_ring[cache->stash_head];
+		cache->stash_ring[cache->stash_head] = NULL;
+		cache->stash_head = (cache->stash_head + 1) % STASH_MAX;
+		cache->stash_used--;
+
+		if (block) {
+			stash_unlink(cache, block);
+			lightrec_free_block(cache->state, block);
+			lightrec_dbg.n_stash_drop++;
+			return true;
+		}
+	}
+
+	return false;
+}
+
+/* (called on the emulation thread, with the block out of the cache and out of
+   the compile queue) */
+void lightrec_stash_block(struct blockcache *cache, struct block *block)
+{
+	u32 slot;
+
+	if (!block->function || !block->code_copy ||
+	    block_has_flag(block, BLOCK_SHOULD_RECOMPILE | BLOCK_NEVER_COMPILE) ||
+	    block->code_size > STASH_BYTES / 4) {
+		lightrec_free_block(cache->state, block);
+		return;
+	}
+
+	while (cache->stash_used == STASH_MAX ||
+	       (cache->stash_count &&
+		cache->stash_bytes + block->code_size > STASH_BYTES)) {
+		if (!stash_drop_oldest(cache))
+			break;
+	}
+
+	slot = (cache->stash_head + cache->stash_used) % STASH_MAX;
+	cache->stash_ring[slot] = block;
+	cache->stash_used++;
+	block->stash_slot = slot;
+
+	block->next = cache->stash[stash_bucket(block->pc)];
+	cache->stash[stash_bucket(block->pc)] = block;
+	cache->stash_count++;
+	cache->stash_bytes += block->code_size;
+	lightrec_dbg.n_stash_add++;
+}
+
+/* a kept block for this address whose code is exactly what is there now */
+struct block * lightrec_stash_take(struct blockcache *cache, u32 pc,
+				   const u32 *code)
+{
+	struct block *block;
+
+	for (block = cache->stash[stash_bucket(pc)]; block; block = block->next) {
+		if (kunseg(block->pc) != kunseg(pc) || block->pc != pc)
+			continue;
+		if (memcmp(block->code_copy, code,
+			   block->code_copy_len * sizeof(u32)))
+			continue;
+
+		stash_unlink(cache, block);
+		lightrec_dbg.n_stash_hit++;
+		return block;
+	}
+
+	return NULL;
+}
+
+bool lightrec_stash_clear(struct blockcache *cache)
+{
+	unsigned int i;
+	struct block *block, *next;
+	bool any = cache->stash_count != 0;
+
+	for (i = 0; i < STASH_BUCKETS; i++) {
+		for (block = cache->stash[i]; block; block = next) {
+			next = block->next;
+			lightrec_free_block(cache->state, block);
+		}
+		cache->stash[i] = NULL;
+	}
+
+	memset(cache->stash_ring, 0, sizeof(cache->stash_ring));
+	cache->stash_head = cache->stash_used = cache->stash_count = 0;
+	cache->stash_bytes = 0;
+
+	return any;
+}
+
 u16 lightrec_get_lut_entry(const struct block *block)
 {
 	return (kunseg(block->pc) >> 2) & (LUT_SIZE - 1);
@@ -84,6 +214,19 @@ void lightrec_register_block(struct blockcache *cache, struct block *block)
 	remove_from_code_lut(cache, block);
 }
 
+/* (a block taken back from the code cache: its compiled code exists, and
+   entries of other blocks inside its range stay) */
+void lightrec_register_block_keep_lut(struct blockcache *cache,
+				      struct block *block)
+{
+	u32 pc = kunseg(block->pc);
+	struct block *old;
+
+	old = cache->lut[(pc >> 2) & (LUT_SIZE - 1)];
+	block->next = old;
+	cache->lut[(pc >> 2) & (LUT_SIZE - 1)] = block;
+}
+
 void lightrec_unregister_block(struct blockcache *cache, struct block *block)
 {
 	u32 pc = kunseg(block->pc);
@@ -162,6 +305,7 @@ void lightrec_remove_outdated_blocks(struct blockcache *cache,
 void lightrec_free_all_blocks_except(struct blockcache *cache,
 				     const struct block *except)
 {
+	lightrec_stash_clear(cache);
 	lightrec_free_blocks(cache, except, true);
 }
 
@@ -172,6 +316,7 @@ void lightrec_free_all_blocks(struct blockcache *cache)
 
 void lightrec_free_block_cache(struct blockcache *cache)
 {
+	lightrec_stash_clear(cache);
 	lightrec_free_all_blocks(cache);
 	lightrec_free(cache->state, MEM_FOR_LIGHTREC, sizeof(*cache), cache);
 }
